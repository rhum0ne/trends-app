# trends° by upTake — variables d'environnement.
# Copier en .env.local (développement) ou les saisir dans Coolify (production).
# Ne jamais commiter de vraie valeur. Toutes sont vides : l'humain les remplit (SETUP.md).

# ─── Site ──────────────────────────────────────────────────────────────────
# Adresse publique, sans barre finale (liens absolus, sitemap, images Open Graph)
NEXT_PUBLIC_SITE_URL=https://trends.uptake.me

# ─── Drapeaux de phase (CLAUDE.md § 3) — "true" pour activer ────────────────
# Phase 1 : site public ouvert (sinon page d'attente ; l'API sert upTake)
PUBLIC_SITE=false
# Phase 2 : clés d'API gratuites
PUBLIC_API_KEYS=false
# Phase 3 : offres payantes (Paddle)
PAID_PLANS=false

# ─── Supabase auto-hébergé dédié à trends° sur le VPS ───────────────────────
# URL HTTPS Kong, utilisée par le navigateur uniquement pour charger les images Storage.
SUPABASE_URL=
# URL Kong sur le réseau Docker Coolify, pour l'application serveur (si disponible).
SUPABASE_INTERNAL_URL=
# Clé anon de cette instance, côté serveur pour l'authentification admin.
SUPABASE_ANON_KEY=
# Clé service : lecture/écriture côté serveur uniquement. Jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
# URL Postgres pour les migrations (scripts/migrate.mjs). En production : hôte interne du conteneur
# supabase-db-<uuid> sur le réseau Coolify ; en local : la base de `supabase start`. Jamais de port 5432 public.
DATABASE_URL=

# ─── IA (clé propre à trends°, séparée de celle d'upTake) ───────────────────
ANTHROPIC_API_KEY=
# Plafond de dépense quotidien en dollars (2 par défaut)
AI_DAILY_BUDGET_USD=2
# Modèle de l'analyse quotidienne (vide = claude-opus-5-5)
AI_MODEL=
# Effort de l'analyse : low, medium, high (défaut) ou xhigh. Coût mesuré dans ai_usage.
AI_EFFORT=

# ─── Google Trends sur BigQuery ────────────────────────────────────────────
# Projet Google Cloud facturé pour les requêtes (palier gratuit : 1 To/mois)
GOOGLE_CLOUD_PROJECT=
# Compte de service avec le rôle « BigQuery Job User » : le JSON complet sur une ligne,
# ou en base64 (les deux sont acceptés). Ou bien GOOGLE_APPLICATION_CREDENTIALS=chemin/vers/cle.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Wikipédia ─────────────────────────────────────────────────────────────
# Contact obligatoire dans le User-Agent (politique Wikimedia), ex. une adresse email ou une page de contact
WIKIMEDIA_CONTACT=

# ─── Photos ────────────────────────────────────────────────────────────────
PEXELS_API_KEY=

# ─── Tâches planifiées ─────────────────────────────────────────────────────
# Secret des routes /api/cron/* (Authorization: Bearer …), utilisé par le superviseur intégré. Générer : openssl rand -hex 32
CRON_SECRET=
# Superviseur intégré (src/instrumentation.ts) : actif en production. « off » le coupe, « on » l'active en local.
SCHEDULER=

# ─── Administration ────────────────────────────────────────────────────────
# Adresses autorisées sur /admin, séparées par des virgules
ADMIN_EMAILS=

# ─── API ───────────────────────────────────────────────────────────────────
# Clé interne d'upTake : ne pas la mettre ici. La créer dans /admin (elle est stockée en empreinte SHA-256).
# Sel facultatif pour les compteurs de débit en mémoire (jamais stocké en base)
RATE_LIMIT_SALT=

# ─── Alertes admin (email) ─────────────────────────────────────────────────
# Fournisseur non arrêté dans CLAUDE.md : Resend si renseigné, sinon incident visible dans /admin seulement
RESEND_API_KEY=
ALERT_FROM=

# ─── Référencement ─────────────────────────────────────────────────────────
# Clé IndexNow (8 à 128 caractères hexadécimaux), servie à la racine sur /{clé}.txt
INDEXNOW_KEY=

# ─── Mesure (facultatif, sans cookie) ──────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Script de mesure d'upTake (adresse donnée par upTake)
NEXT_PUBLIC_UPTAKE_SCRIPT_SRC=
